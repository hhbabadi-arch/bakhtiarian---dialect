
<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div id="map" style="height: 400px; border-radius: 8px; margin: 20px 0;"></div>

<script>
  // مختصات مرکزی (دهنو سفلی)
  var map = L.map('map').setView([32.44333, 50.20139], 13);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap'
  }).addTo(map);

  // نشانگر دهنو سفلی
  L.marker([32.44333, 50.20139]).addTo(map)
    .bindPopup('<b>دهنو سفلی</b><br>روستای هدف گردشگری');

  // نشانگر تقریبی تنگه قربان (۴۰۰ متر جنوب دهنو سفلی)
  L.marker([32.4397, 50.20139]).addTo(map)
    .bindPopup('<b>تنگه قربان (دنگ قربان)</b><br>محوطه تاریخی دوره هخامنشی');
</script>
