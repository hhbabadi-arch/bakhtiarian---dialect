  <div class="container" style="margin-top: 30px; background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
    <h2 style="color: #1a5c3a; text-align: center;">جست‌وجو در واژگان گویشوران</h2>
    <div style="text-align: center; margin-bottom: 20px;">
      <input type="text" id="search-input" placeholder="یک واژه فارسی تایپ کنید... (مثلاً: آب، رفتن)" style="padding: 10px; width: 60%; max-width: 300px; border: 1px solid #ccc; border-radius: 5px; font-family: inherit;">
    </div>
    <table id="vocab-table" style="width: 100%; border-collapse: collapse; text-align: right; direction: rtl;">
      <thead>
        <tr style="background: #e8f5e9; color: #1a5c3a;">
          <th style="padding: 10px; border: 1px solid #c8e6c9;">واژه فارسی</th>
          <th style="padding: 10px; border: 1px solid #c8e6c9;">گویش بختیاری</th>
          <th style="padding: 10px; border: 1px solid #c8e6c9;">گویشور</th>
        </tr>
      </thead>
      <tbody id="vocab-body">
        <!-- داده‌ها اینجا لود می‌شوند -->
      </tbody>
    </table>
  </div>

  <script>
    // کدهای قبلی لود گویشوران اینجا هستند...
    // (کد قبلی را پاک نکنید، فقط این را اضافه کنید)

    let allVocab = []; // ذخیره کل واژه‌ها

    async function loadVocabulary() {
      const tbody = document.getElementById('vocab-body');
      for (const file of speakerFiles) {
        try {
          const response = await fetch(file);
          if (!response.ok) continue;
          const data = await response.json();
          
          // اگر گویشور واژه‌نامه داشت
          if (data.lexicon) {
            for (const [fa, bqi] of Object.entries(data.lexicon)) {
              allVocab.push({ farsi: fa, bakhtiari: bqi, speaker: data.name });
            }
          }
        } catch (error) {
          console.error('خطا:', error);
        }
      }
      renderVocab(allVocab);
    }

    function renderVocab(vocabList) {
      const tbody = document.getElementById('vocab-body');
      tbody.innerHTML = '';
      if (vocabList.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 10px;">واژه‌ای یافت نشد</td></tr>';
        return;
      }
      vocabList.forEach(v => {
        const tr = document.createElement('tr');
        tr.innerHTML = 
          <td style="padding: 8px; border: 1px solid #eee;">${v.farsi}</td>
          <td style="padding: 8px; border: 1px solid #eee; font-weight: bold; color: #2e7d52;">${v.bakhtiari}</td>
          <td style="padding: 8px; border: 1px solid #eee; font-size: 0.9rem; color: #777;">${v.speaker}</td>
        ;
        tbody.appendChild(tr);
      });
    }

    // جست‌وجوی زنده
    document.getElementById('search-input').addEventListener('input', (e) => {
      const query = e.target.value.trim();
      const filtered = allVocab.filter(v => 
        v.farsi.includes(query) || v.bakhtiari.includes(query)
      );
      renderVocab(filtered);
    });

    // اجرای بارگذاری
    loadVocabulary();
  </script>
</body>
